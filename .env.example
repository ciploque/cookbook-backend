# Server
NODE_ENV=development                    # development | test | production
PORT=3001                               # HTTP server port
API_BASE_PATH=/api                      # Base path; version is appended per-router (e.g. /api/v1/users)

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/cookbook_dev

# Clerk — JWT validation
CLERK_SECRET_KEY=sk_test_your_secret_key_here   # From Clerk dashboard → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here  # Optional for pure backend

# Clerk — webhooks (Dashboard → Webhooks → Signing Secret, starts with whsec_)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_signing_secret_here

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://cookbook.example.com

# Image validation (legacy — RecipeStep.imageUrl only; recipe cover/gallery images
# now go through the R2 upload endpoints below)
# Comma-separated hostnames; imageUrl fields must come from one of these
TRUSTED_IMAGE_DOMAINS=your-bucket.r2.dev,your-bucket.s3.amazonaws.com

# Cloudflare R2 — recipe cover/gallery image storage
# Dashboard → R2 → Manage API Tokens → create a token scoped to R2_BUCKET_NAME
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=cookbook-images
# Public bucket domain used to build full image URLs from stored relative paths
# (r2.dev dev domain, or a custom domain mapped to the bucket)
R2_PUBLIC_BASE_URL=https://your-bucket.r2.dev

# Meilisearch
MEILISEARCH_URL=http://localhost:7700    # Meilisearch base URL
MEILISEARCH_API_KEY=masterkey           # Master key (set MEILI_MASTER_KEY in docker-compose to match)

# Logging
LOG_LEVEL=info                           # trace | debug | info | warn | error
