generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid(7)) @db.Uuid
  authProviderId String   @unique
  username       String   @unique
  displayName    String
  bio            String?
  about          String?
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recipes             Recipe[]
  reviews             Review[]
  collections         Collection[]
  followedCollections CollectionFollower[]
  reports             Report[]             @relation("ReportReporter")

  @@map("users")
}

model Recipe {
  id              String   @id @default(uuid(7)) @db.Uuid
  slug            String
  title           String
  description     String?
  authorNote      String?
  coverImageUrl   String?
  imageUrls       String[]
  videoUrl        String?
  prepTimeMinutes Int?
  servings        Int?
  difficulty      Int?
  authorId        String   @db.Uuid
  reviewCount     Int      @default(0)
  ratingSum       Int      @default(0)
  averageRating   Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author           User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients      RecipeIngredient[]
  steps            RecipeStep[]
  recipeTags       RecipeTag[]
  recipeCategories RecipeCategory[]
  reviews          Review[]
  collections      CollectionRecipe[]
  reports          Report[]
  shelfItems       ShelfItem[]

  @@unique([authorId, slug])
  @@index([authorId])
  @@index([averageRating])
  @@map("recipes")
}

model RecipeIngredient {
  id       String  @id @default(uuid(7)) @db.Uuid
  recipeId String  @db.Uuid
  name     String
  quantity Float?
  unit     String?
  notes    String?
  order    Int     @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id          String  @id @default(uuid(7)) @db.Uuid
  recipeId    String  @db.Uuid
  order       Int
  instruction String
  imageUrl    String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, order])
  @@index([recipeId])
  @@map("recipe_steps")
}

model Tag {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @unique
  slug String @unique

  recipeTags RecipeTag[]

  @@map("tags")
}

model RecipeTag {
  recipeId String @db.Uuid
  tagId    String @db.Uuid

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@index([tagId])
  @@map("recipe_tags")
}

// Categories are normalized and *curated*: unlike tags, they are not created on the fly by a
// recipe write. The registry is src/modules/categories/categories.config.ts, applied by
// `npm run categories:sync`; an unknown slug on a recipe write is a 422.
model Category {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @unique
  slug String @unique

  recipeCategories RecipeCategory[]

  @@map("categories")
}

model RecipeCategory {
  recipeId   String @db.Uuid
  categoryId String @db.Uuid

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([recipeId, categoryId])
  @@index([categoryId])
  @@map("recipe_categories")
}

model Review {
  id        String   @id @default(uuid(7)) @db.Uuid
  recipeId  String   @db.Uuid
  authorId  String   @db.Uuid
  rating    Int
  content   String?
  imageUrls String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([recipeId, authorId])
  @@index([recipeId])
  @@index([authorId])
  @@map("reviews")
}

model Collection {
  id          String   @id @default(uuid(7)) @db.Uuid
  ownerId     String   @db.Uuid
  slug        String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recipes   CollectionRecipe[]
  followers CollectionFollower[]

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@map("collections")
}

model CollectionRecipe {
  collectionId String @db.Uuid
  recipeId     String @db.Uuid
  order        Int

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([collectionId, recipeId])
  @@index([collectionId])
  @@index([recipeId])
  @@map("collection_recipes")
}

model CollectionFollower {
  collectionId String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
  @@index([userId])
  @@map("collection_followers")
}

// One table for every kind of report, with a real typed FK per reportable entity
// rather than an untyped targetId — see "Schema decisions" in CLAUDE.md.
model Report {
  id         String   @id @default(uuid(7)) @db.Uuid
  targetType String
  topic      String
  message    String?
  status     String   @default("pending")
  reporterId String   @db.Uuid
  recipeId   String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reporter User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, reporterId])
  @@index([reporterId])
  @@map("reports")
}

// A themed row on the landing page ("Top Drinks", "Recently Added", a seasonal row…).
// `source` names a resolver in src/modules/shelves/resolvers, `criteria` is that resolver's
// own Zod-validated payload — so a new kind of theme is a new resolver, not a migration.
// Contents are a precomputed snapshot in ShelfItem, rewritten by `npm run shelves:refresh`.
model Shelf {
  id          String    @id @default(uuid(7)) @db.Uuid
  slug        String    @unique
  title       String
  subtitle    String?
  source      String // resolver name: "query" | "manual" | "trending"
  criteria    Json // resolver-specific, validated per source at sync time
  maxItems    Int       @default(20)
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  startsAt    DateTime? // publish window — seasonal rows self-activate and retire
  endsAt      DateTime?
  refreshedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items ShelfItem[]

  @@index([isActive, position])
  @@map("shelves")
}

// The resolved snapshot of a shelf. Cascades on recipe delete, so a removed recipe drops
// out of every shelf with no cleanup job.
model ShelfItem {
  shelfId  String @db.Uuid
  recipeId String @db.Uuid
  order    Int

  shelf  Shelf  @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([shelfId, recipeId])
  @@index([shelfId, order])
  @@map("shelf_items")
}
